# AI Core Configuration (Not required: using 'agy' CLI with logged-in session for copywriting and Veo 3)
# GEMINI_API_KEY=your_gemini_api_key

# RunPod Configuration
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_POD_ID=your_runpod_pod_id

# Alibaba Cloud ECS Configuration
ALIBABA_ACCESS_KEY_ID=your_ali_access_key_id
ALIBABA_ACCESS_KEY_SECRET=your_ali_access_key_secret
ALIBABA_INSTANCE_ID=your_ali_instance_id
ALIBABA_REGION_ID=ap-southeast-1

# Cloudflare R2 Storage (For publishing public media URLs to Facebook & TikTok)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_cloudflare_r2_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=your_cloudflare_r2_public_url

# Social Media Integration
SOCIAL_INTEGRATION_API_URL=http://localhost:5000/api/posts
